<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsc.app"
    android:versionCode="7"
    android:versionName="0.1.2">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- 真实网络请求（HttpURLConnection 走 Java 侧，C 侧只做 SSE 解析） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 余额提醒 / 更新提醒：Android 13 起为运行时权限，代码里会先判断再申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 更新安装：只用于把校验通过的安装包交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 蓝牙 RFCOMM 同步通道（技术设计 16.1）：Android 12 起需要 CONNECT 运行时权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 插件宿主：单独进程 :plugin，插件调用再一次 fork 出一次性进程（技术设计 10.1） -->
        <service
            android:name=".PluginHostService"
            android:exported="false"
            android:process=":plugin" />

        <!-- 插件进程入口：由 PluginHostService 用 am broadcast 拉起，落在 :plugin 的派生进程里 -->
        <receiver
            android:name=".PluginWorker$Receiver"
            android:exported="false"
            android:process=":plugincall" />

        <!-- 私有目录文件的只读共享（导出记录分享、安装包交给系统安装器） -->
        <provider
            android:name=".DscFileProvider"
            android:authorities="com.dsc.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
