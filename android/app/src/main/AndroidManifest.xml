<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sai.app"
    android:versionCode="4"
    android:versionName="1.3.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- 真实网络请求（HttpURLConnection 走 Java 侧，C 侧只做 SSE 解析） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 余额提醒 / 更新提醒：Android 13 起为运行时权限，代码里会先判断再申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 更新安装：只用于把校验通过的安装包交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 私有目录文件的只读共享（导出记录分享、安装包交给系统安装器） -->
        <provider
            android:name=".SaiFileProvider"
            android:authorities="com.sai.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
